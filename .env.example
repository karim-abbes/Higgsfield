# Identifiants Higgsfield Cloud (https://cloud.higgsfield.ai/)
# Format combiné :
HF_KEY=your-api-key:your-api-secret

# …ou séparés :
# HF_API_KEY=your-api-key
# HF_API_SECRET=your-api-secret

# Google Places API (New) — carte profil Google (scripts/render_google_card.py)
# Active "Places API (New)" + facturation dans Google Cloud Console.
GOOGLE_MAPS_API_KEY=your-google-places-api-key
